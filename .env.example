# Copy to .env (local) and set the same values as Environment Variables in Vercel.
# NEVER commit a real .env file. NEVER paste a real password here.

# Local dev (SQLite file). Production: Neon PostgreSQL connection string.
DATABASE_URL="file:./dev.db"

# Admin login for /admin (email + bcrypt hash of the password, NOT the password itself).
# Generate the hash locally with: npm run hash-password
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2b$10$REPLACE_WITH_BCRYPT_HASH"
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Vercel Blob (photo uploads in production). Optional locally: without it,
# uploads are saved under public/uploads/ instead.
BLOB_READ_WRITE_TOKEN=""
